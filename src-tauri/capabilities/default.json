{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability configuration for RentFlow desktop application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-[un]maximize",
    "core:window:allow-[un]minimize",
    "core:path:default",
    "core:path:allow-app-data-dir",
    "core:path:allow-app-config-dir",
    "core:path:allow-app-local-data-dir",
    "core:path:allow-app-cache-dir",
    "core:path:allow-desktop-dir",
    "core:path:allow-document-dir",
    "core:path:allow-download-dir",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "oauth:default",
    "stronghold:default",
    "updater:default",
    "updater:allow-check"
  ]
}
